# JanMitra Admin Dashboard - Environment Configuration
# Copy this file to ".env" and fill in real values. The ".env" file is git-ignored.

# Supabase (shared with the JanMitra mobile app — same project, same database).
# Use the publishable/anon key (safe for client use, NOT a service-role key).
VITE_SUPABASE_URL=https://your-supabase-project-url.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-anon-key

# Mapbox access token (for the Civic Map — Mapbox GL JS)
VITE_MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Google Maps JS API key (legacy — unused)
VITE_GOOGLE_MAPS_API_KEY=
