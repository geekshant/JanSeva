# JanMitra Backend - Environment Variables
# Copy this file to .env and fill in real values.

# --- Server ---
NODE_ENV=development
PORT=8080
HOST=0.0.0.0
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Database (PostgreSQL + PostGIS) ---
# Example: postgresql://janmitra:janmitra@localhost:5432/janmitra
DATABASE_URL=postgresql://janmitra:janmitra@localhost:5432/janmitra

# --- JWT ---
# REQUIRED in production: a strong random string of at least 32 characters.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars
JWT_EXPIRES_IN=24h
JWT_REFRESH_EXPIRES_IN=7d
JWT_ISSUER=janmitra

# --- Auth mode ---
# "jwt" (default) for simple email/otp auth, "firebase" to verify Firebase ID tokens.
AUTH_MODE=jwt

# --- Firebase Admin (only needed when AUTH_MODE=firebase) ---
# Either point to a service account JSON file or export FIREBASE_SERVICE_ACCOUNT (base64).
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json

# --- Cloudinary (image uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=janmitra/complaints
CLOUDINARY_SIGNED_URL_EXPIRES=3600

# --- Redis (optional, for BullMQ / pub-sub production) ---
REDIS_URL=redis://localhost:6379

# --- Demo bootstrap ---
SEED_DEMO_ADMIN_EMAIL=admin@janmitra.local
SEED_DEMO_ADMIN_PASSWORD=Admin@12345

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=300
RATE_LIMIT_AUTH_MAX=20