# JanMitra environment configuration
# Copy this file to ".env" and fill in real values. The ".env" file is git-ignored.

# Supabase
SUPABASE_URL=your-supabase-project-url
SUPABASE_ANON_KEY=your-supabase-anon-key

# Mapbox
MAPBOX_ACCESS_TOKEN=your-mapbox-access-token

# Firebase Cloud Messaging (client-side public config only - NO server keys).
# Find these in Firebase Console > Project settings > General > Your apps.
# Push stays disabled until all four required values are filled in.
FIREBASE_API_KEY=your-firebase-api-key
FIREBASE_APP_ID=your-firebase-app-id
FIREBASE_MESSAGING_SENDER_ID=your-fcm-sender-id
FIREBASE_PROJECT_ID=your-firebase-project-id
# Optional
FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
FIREBASE_STORAGE_BUCKET=your-project.appspot.com

# App
APP_ENV=development
